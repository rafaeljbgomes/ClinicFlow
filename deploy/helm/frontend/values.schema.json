{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["name", "image", "port", "services", "oidc", "gatewayUrl", "cookieSecure"],
  "properties": {
    "gatewayUrl": { "type": "string", "pattern": "^https?://[^/]+(:[0-9]+)?$" },
    "cookieSecure": { "type": "boolean" },
    "name": { "type": "string", "minLength": 1 },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "oneOf": [
        {
          "properties": {
            "tag": { "minLength": 1, "not": { "const": "latest" } },
            "digest": { "maxLength": 0 }
          }
        },
        {
          "properties": {
            "tag": { "maxLength": 0 },
            "digest": { "pattern": "^sha256:[a-fA-F0-9]{64}$" }
          }
        }
      ]
    },
    "oidc": {
      "type": "object",
      "required": ["issuer", "internalIssuer", "publicUrl", "clientSecretName", "clientSecretKey", "component", "port"],
      "additionalProperties": false,
      "properties": {
        "issuer": { "type": "string", "pattern": "^https?://[^/ ]+(/[^/ ]+)*/realms/[^/ ]+$" },
        "internalIssuer": { "type": "string", "pattern": "^https?://[^/ ]+(/[^/ ]+)*/realms/[^/ ]+$" },
        "publicUrl": { "type": "string", "pattern": "^https?://[^/ ]+$" },
        "clientSecretName": { "type": "string", "minLength": 1 },
        "clientSecretKey": { "type": "string", "minLength": 1 },
        "component": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    }
  }
}
