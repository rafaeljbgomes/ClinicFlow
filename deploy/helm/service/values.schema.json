{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["name", "image", "port", "database", "credentials", "oidc", "jwt"],
  "oneOf": [
    { "properties": { "oidc": { "properties": { "enabled": { "const": true } } }, "jwt": { "properties": { "enabled": { "const": false } } } } },
    { "properties": { "oidc": { "properties": { "enabled": { "const": false } } }, "jwt": { "properties": { "enabled": { "const": true } } } } }
  ],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "managementPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "oneOf": [
        {
          "properties": {
            "tag": { "minLength": 1, "not": { "const": "latest" } },
            "digest": { "maxLength": 0 }
          }
        },
        {
          "properties": {
            "tag": { "maxLength": 0 },
            "digest": { "pattern": "^sha256:[a-fA-F0-9]{64}$" }
          }
        }
      ]
    },
    "database": {
      "type": "object",
      "required": ["name", "host", "port"],
      "not": { "required": ["secretName"] }
    },
    "rabbitmq": {
      "type": "object",
      "required": ["enabled", "host", "port"],
      "not": { "required": ["secretName"] }
    },
    "credentials": {
      "type": "object",
      "required": ["secretName", "checksum"],
      "additionalProperties": false,
      "properties": {
        "secretName": { "type": "string" },
        "checksum": { "type": "string", "pattern": "^([a-f0-9]{64})?$" }
      }
    },
    "oidc": {
      "type": "object",
      "required": ["enabled", "issuer", "jwksUri", "component", "port"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "issuer": { "type": "string", "pattern": "^https?://[^/ ]+(/[^/ ]+)*/realms/[^/ ]+$" },
        "jwksUri": { "type": "string", "pattern": "^https?://[^/ ]+/[^ ]*$" },
        "component": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "jwt": {
      "type": "object",
      "required": ["enabled", "issuer", "secretName", "publicKeyKey", "privateKeyKey", "privateKeyEnabled"],
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "serviceIngress": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" }
        },
        "serviceEgress": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["component", "port"],
            "additionalProperties": false,
            "properties": {
              "component": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
            }
          }
        }
      }
    }
  }
}
